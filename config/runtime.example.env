# Copy to .env.local. Fill paths for THIS computer. Never commit credentials.
CONTOUR_LLM_BACKEND=gigachat
GIGACHAT_MODEL=GigaChat-3-Ultra
# Store GIGACHAT_AUTH_KEY in an external file, not in this template.
# CONTOUR_CREDENTIALS_FILE=D:/AI/credentials/contour.env
# If needed, use the official CA certificate file. TLS verification stays enabled.
# GIGACHAT_CA_FILE=D:/AI/credentials/sber-root.pem
# pnpm start listens only on 127.0.0.1.
PORT=5176
